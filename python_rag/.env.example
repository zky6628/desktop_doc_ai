# 阿里云 DashScope API Key
# 申请地址：https://dashscope.console.aliyun.com/
# 注意：将此文件复制为 .env 并填入真实的 API Key
DASHSCOPE_API_KEY=your_dashscope_api_key_here
# Mineru API Token
# 申请地址：https://mineru.ai/
MINERU_API_TOKEN=your_mineru_api_token_here
# 工作台业务 SQLite 事实库路径（默认 python_rag/data/workbench.db）
WORKBENCH_DB_PATH=
# 上传暂存受控目录（默认 python_rag/uploads/staging）
WORKBENCH_STAGING_DIR=
# 解析任务 Worker 开关（默认启用；设为 0/false/off 关闭后导入任务停留队列）
WORKBENCH_WORKER_ENABLED=
# 工作台向量库持久化目录（默认 python_rag/data/chroma_workbench，与旧链路 chroma_db 隔离）
WORKBENCH_CHROMA_DIR=
# /search 调试UI WORKBENCH_LOCAL_DEBUG=1-开启/0-关闭
WORKBENCH_LOCAL_DEBUG=0
